{
  "enabled": true,
  "service_worker": {
    "path": "/sw.js",
    "scope": "/"
  },
  "cache": {
    "name": "analytics-ui-shell-v2",
    "app_shell": [
      "/",
      "/index.html",
      "/manifest.webmanifest"
    ],
    "bypass_prefixes": [
      "/api/"
    ],
    "asset_prefixes": [
      "/assets/",
      "/icons/"
    ],
    "manifest_path": "/manifest.webmanifest"
  },
  "manifest": {
    "name": "Analytics UI",
    "short_name": "Analytics",
    "description": "Аналітична панель",
    "lang": "uk",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#07101a",
    "theme_color": "#08111b",
    "orientation": "any",
    "icons": [
      {
        "src": "/icons/icon-192.png",
        "sizes": "192x192",
        "type": "image/png"
      },
      {
        "src": "/icons/icon-512.png",
        "sizes": "512x512",
        "type": "image/png"
      },
      {
        "src": "/icons/icon-maskable-512.png",
        "sizes": "512x512",
        "type": "image/png",
        "purpose": "maskable"
      }
    ]
  }
}
