{
  "dev_server": {
    "port": 5173,
    "proxy": [
      {
        "prefix": "/api",
        "target": "http://localhost:8000"
      }
    ]
  },
  "openapi": {
    "target": "./openapi.json",
    "output": "./src/api/generated/backend.ts",
    "schemas": "./src/api/generated/model",
    "base_url_from_specification": false
  }
}
